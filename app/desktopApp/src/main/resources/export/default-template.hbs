<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timesheet {{rangeLabel}}</title>
    {{{tailwindRuntime}}}
    <style>
      @page { margin: 24px; }
    </style>
  </head>
  <body class="bg-white text-slate-800 font-sans text-[13px] leading-relaxed">
    <main class="max-w-3xl mx-auto p-6">
      <header class="flex items-start justify-between border-b border-slate-200 pb-5 mb-6">
        <div>
          <h1 class="text-2xl font-semibold text-slate-900">Timesheet</h1>
          <p class="text-slate-500 mt-1">{{rangeLabel}}</p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-slate-900">${{totals.billableAmount}}</p>
          <p class="text-slate-500 text-xs uppercase tracking-wide">Billable total</p>
        </div>
      </header>

      <section class="grid grid-cols-4 gap-3 mb-8">
        <div class="rounded-lg bg-slate-50 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-slate-400">Days</p>
          <p class="text-lg font-semibold text-slate-900">{{totals.dayCount}}</p>
        </div>
        <div class="rounded-lg bg-slate-50 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-slate-400">Entries</p>
          <p class="text-lg font-semibold text-slate-900">{{totals.entryCount}}</p>
        </div>
        <div class="rounded-lg bg-slate-50 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-slate-400">Tracked</p>
          <p class="text-lg font-semibold text-slate-900">{{totals.durationLabel}}</p>
        </div>
        <div class="rounded-lg bg-emerald-50 px-4 py-3">
          <p class="text-xs uppercase tracking-wide text-emerald-500">Billable</p>
          <p class="text-lg font-semibold text-emerald-700">${{totals.billableAmount}}</p>
        </div>
      </section>

      {{#if projects.length}}
      <section class="mb-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400 mb-2">By project</h2>
        <table class="w-full text-left">
          <thead>
            <tr class="text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
              <th class="py-2">Project</th>
              <th class="py-2">Client</th>
              <th class="py-2 text-right">Tracked</th>
              <th class="py-2 text-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            {{#each projects}}
            <tr class="border-b border-slate-100">
              <td class="py-2 font-medium text-slate-800">{{name}}</td>
              <td class="py-2 text-slate-500">{{client}}</td>
              <td class="py-2 text-right tabular-nums">{{durationLabel}}</td>
              <td class="py-2 text-right tabular-nums">${{amount}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      {{/if}}

      {{#each days}}
      <section class="mb-6 break-inside-avoid">
        <div class="flex items-baseline justify-between mb-2">
          <h3 class="font-semibold text-slate-900">{{label}}</h3>
          <span class="text-slate-500 text-xs">{{durationLabel}} &middot; ${{billableAmount}}</span>
        </div>
        <table class="w-full text-left">
          <thead>
            <tr class="text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
              <th class="py-1.5">Time</th>
              <th class="py-1.5">Task</th>
              <th class="py-1.5">Project</th>
              <th class="py-1.5 text-right">Duration</th>
              <th class="py-1.5 text-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
            <tr class="border-b border-slate-100 align-top">
              <td class="py-1.5 text-slate-500 whitespace-nowrap tabular-nums">{{startTime}} – {{endTime}}</td>
              <td class="py-1.5">
                <span class="font-medium text-slate-800">{{title}}</span>
                {{#unless billable}}<span class="ml-2 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] uppercase text-slate-500">non-billable</span>{{/unless}}
                {{#if notes}}<div class="text-slate-500 text-xs mt-0.5">{{notes}}</div>{{/if}}
              </td>
              <td class="py-1.5 text-slate-500">{{projectName}}</td>
              <td class="py-1.5 text-right tabular-nums">{{durationLabel}}</td>
              <td class="py-1.5 text-right tabular-nums">{{#if billable}}${{amount}}{{else}}—{{/if}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      {{/each}}

      <footer class="mt-8 pt-4 border-t border-slate-200 text-xs text-slate-400">
        Generated by timeboxxing &middot; {{rangeLabel}}
      </footer>
    </main>
  </body>
</html>
