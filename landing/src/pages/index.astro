---
import BaseLayout from "../layouts/BaseLayout.astro";
import { downloads, signupEndpoint } from "@lib/site";

const title = "Timeboxxing | Bill from facts, not memory";
const description =
  "Timeboxxing is a desktop usage tracker for freelancers and focused workers who want cleaner billable records from real app activity.";

const features = [
  {
    eyebrow: "Capture",
    title: "Your day, reconstructed automatically",
    copy:
      "Apps, documents, browser work, meetings, and messages become a timeline you can actually review.",
  },
  {
    eyebrow: "Convert",
    title: "Billable entries without archaeology",
    copy:
      "Select the captured work that matters, assign it to a project, add context, and move on.",
  },
  {
    eyebrow: "Export",
    title: "Clean records for the rest of your workflow",
    copy:
      "Export CSV or JSON when you are ready to invoice, reconcile, or keep a private work log.",
  },
];

const trustItems = [
  "Desktop-first tracking for your own records, not a manager dashboard.",
  "Downloads stay open. The optional email form never gates the app.",
  "AI usage questions remain optional and only appear when configured in the desktop app.",
];

const faqs = [
  {
    question: "Is Timeboxxing for freelancers or personal productivity?",
    answer:
      "Both. It is built around freelancer workflows like project entries and exports, while also helping individuals understand where their attention went.",
  },
  {
    question: "Do I have to sign up before downloading?",
    answer:
      "No. Downloads stay available. The email field is only for optional updates once a signup endpoint is configured.",
  },
  {
    question: "Which platforms are planned?",
    answer:
      "The installer project currently targets macOS DMG and Windows EXE builds, so the landing page starts with those two paths.",
  },
  {
    question: "Does this replace my invoicing tool?",
    answer:
      "No. Timeboxxing helps create cleaner source records and exports them, so you can feed the tools you already use.",
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Timeboxxing home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Timeboxxing</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="#workflow">Workflow</a>
      <a href="#privacy">Privacy</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="header-cta" href="#download">Download</a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-reveal style="--reveal-delay: 0ms">
          Desktop usage tracker for billable work
        </p>
        <h1 id="hero-title" data-hero-reveal style="--reveal-delay: 80ms">
          Bill from facts, not memory.
        </h1>
        <p class="hero-lede" data-hero-reveal style="--reveal-delay: 160ms">
          Timeboxxing turns real app activity into project entries, timesheets, and a clearer picture
          of where your attention went.
        </p>
        <dl class="hero-metrics" aria-label="Demo day metrics" data-hero-reveal style="--reveal-delay: 240ms">
          <div>
            <dt>Captured</dt>
            <dd>4h 5m</dd>
          </div>
          <div>
            <dt>Billable</dt>
            <dd>2h 52m</dd>
          </div>
          <div>
            <dt>Unassigned</dt>
            <dd>45m</dd>
          </div>
        </dl>
        <div class="hero-actions" id="download" data-hero-reveal style="--reveal-delay: 320ms">
          <a
            class="button button-primary"
            href={downloads.macos.href}
            data-download-link
            data-platform="macos"
          >
            {downloads.macos.label}
          </a>
          <a
            class="button button-secondary"
            href={downloads.windows.href}
            data-download-link
            data-platform="windows"
          >
            {downloads.windows.label}
          </a>
        </div>
        <p class="cta-note" data-platform-note>
          macOS and Windows installers are published from GitHub releases.
        </p>
      </div>
      <figure
        class="hero-visual"
        aria-label="Timeboxxing desktop app preview"
        data-hero-reveal
        style="--reveal-delay: 220ms"
      >
        <span class="screenshot-badge">Real app capture</span>
        <img
          src="/images/timeboxxing-product-preview.png"
          width="2560"
          height="1720"
          alt="Dark Timeboxxing desktop app showing a usage schedule, selected captured activity, time entry form, and project totals."
          loading="eager"
          decoding="async"
        />
        <figcaption>Sanitized demo data rendered from the actual Timeboxxing desktop UI.</figcaption>
      </figure>
    </section>

    <section class="proof-strip" aria-label="Product highlights">
      <div data-animate data-animate-delay="0ms">
        <strong>No more end-of-day guessing</strong>
        <span>Review the trail your work already left behind.</span>
      </div>
      <div data-animate data-animate-delay="80ms">
        <strong>Built for solo operators</strong>
        <span>Client work, admin, research, and meetings in one place.</span>
      </div>
      <div data-animate data-animate-delay="160ms">
        <strong>Portable by default</strong>
        <span>Keep CSV and JSON records close to the tools you use.</span>
      </div>
    </section>

    <section class="section intro-band" id="workflow" aria-labelledby="workflow-title">
      <div class="section-heading" data-animate>
        <p class="eyebrow">Workflow</p>
        <h2 id="workflow-title">A sharper loop from work done to work billed.</h2>
        <p>
          Timeboxxing is for the messy middle of freelance work: documents, calls, chats,
          research, and all the switching that becomes invisible by invoice time.
        </p>
      </div>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article class="feature-card" data-animate data-animate-delay={`${index * 90}ms`}>
            <p>{feature.eyebrow}</p>
            <h3>{feature.title}</h3>
            <span>{feature.copy}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section split-band" aria-labelledby="personal-title">
      <div class="section-heading compact" data-animate>
        <p class="eyebrow">Freelance billing + personal awareness</p>
        <h2 id="personal-title">Know what to bill. Know what drained the day.</h2>
      </div>
      <div class="compare-layout">
        <article class="use-case" data-animate data-animate-delay="80ms">
          <span class="icon-chip" aria-hidden="true">01</span>
          <h3>For client work</h3>
          <p>
            Build project entries from real usage sessions and carry structured records into
            invoicing instead of rebuilding your day from scattered clues.
          </p>
        </article>
        <article class="use-case" data-animate data-animate-delay="160ms">
          <span class="icon-chip" aria-hidden="true">02</span>
          <h3>For your own attention</h3>
          <p>
            Review patterns across apps and days so you can spot where deep work, admin,
            meetings, and context switching are really landing.
          </p>
        </article>
      </div>
    </section>

    <section class="section privacy-band" id="privacy" aria-labelledby="privacy-title">
      <div class="section-heading" data-animate>
        <p class="eyebrow">Trust</p>
        <h2 id="privacy-title">Your work history should answer to you first.</h2>
        <p>
          Timeboxxing starts as a desktop app for your own records. The landing page keeps the
          same posture: no hidden signup funnel, no analytics layer added here.
        </p>
      </div>
      <ul class="trust-list">
        {trustItems.map((item, index) => (
          <li data-animate data-animate-delay={`${index * 80}ms`}>
            <span aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section class="section signup-band" aria-labelledby="signup-title" data-animate>
      <div>
        <p class="eyebrow">Updates</p>
        <h2 id="signup-title">Follow the launch without blocking the download.</h2>
        <p>
          The email field is optional and only submits when a public endpoint is configured.
          The installers stay one click away.
        </p>
      </div>
      <form class="signup-form" data-signup-form data-endpoint={signupEndpoint} novalidate>
        <label for="email">Email address</label>
        <div class="form-row">
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            data-email-input
          />
          <button class="button button-primary" type="submit" data-signup-button>
            Notify me
          </button>
        </div>
        <p class="form-status" data-form-status aria-live="polite">
          Signup is not connected yet. You can still download Timeboxxing above.
        </p>
      </form>
    </section>

    <section class="section faq-band" id="faq" aria-labelledby="faq-title">
      <div class="section-heading compact" data-animate>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Before you install, the useful bits.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0} data-animate data-animate-delay={`${index * 70}ms`}>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title" data-animate>
      <p class="eyebrow">Ready when the day gets complicated</p>
      <h2 id="final-title">Stop billing from memory. Start with the activity you already created.</h2>
      <div class="hero-actions">
        <a class="button button-primary" href={downloads.macos.href} data-download-link data-platform="macos">
          {downloads.macos.label}
        </a>
        <a class="button button-secondary" href={downloads.windows.href} data-download-link data-platform="windows">
          {downloads.windows.label}
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>Timeboxxing by Skulpture</span>
    <a href="https://github.com/skulpturenz/timeboxxing">GitHub</a>
  </footer>

  <script>
    const animatedElements = [...document.querySelectorAll<HTMLElement>("[data-animate]")];
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (animatedElements.length) {
      animatedElements.forEach((element) => {
        const delay = element.getAttribute("data-animate-delay");
        if (delay) {
          element.style.setProperty("--reveal-delay", delay);
        }
      });

      if (prefersReducedMotion.matches || !("IntersectionObserver" in window)) {
        animatedElements.forEach((element) => element.toggleAttribute("data-visible", true));
      } else {
        document.documentElement.classList.add("motion-ready");
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.toggleAttribute("data-visible", true);
              revealObserver.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px 10% 0px",
            threshold: 0.04,
          },
        );

        animatedElements.forEach((element) => revealObserver.observe(element));
      }
    }

    const platformNote = document.querySelector("[data-platform-note]");
    const downloadLinks = [...document.querySelectorAll("[data-download-link]")];

    const platform = (() => {
      const platformValue = navigator.platform.toLowerCase();
      const userAgent = navigator.userAgent.toLowerCase();
      if (platformValue.includes("mac")) return "macos";
      if (platformValue.includes("win") || userAgent.includes("windows")) return "windows";
      return "";
    })();

    if (platform) {
      downloadLinks.forEach((link) => {
        const isMatch = link.getAttribute("data-platform") === platform;
        link.toggleAttribute("data-preferred", isMatch);
        if (isMatch && platformNote) {
          const label = platform === "macos" ? "macOS" : "Windows";
          platformNote.textContent = `${label} looks right for this device. Both downloads remain available from GitHub releases.`;
        }
      });
    }

    const form = document.querySelector("[data-signup-form]");
    const status = document.querySelector("[data-form-status]");
    const input = document.querySelector("[data-email-input]");
    const button = document.querySelector("[data-signup-button]");
    const endpoint = form?.getAttribute("data-endpoint")?.trim();

    if (form && status && input instanceof HTMLInputElement && button instanceof HTMLButtonElement) {
      const setStatus = (message: string, tone = "neutral") => {
        status.textContent = message;
        status.setAttribute("data-tone", tone);
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!endpoint) {
          setStatus("Signup is not connected yet. Downloads stay open above.", "neutral");
          return;
        }

        if (!input.validity.valid || !input.value.trim()) {
          setStatus("Enter a valid email address first.", "error");
          input.focus();
          return;
        }

        button.disabled = true;
        setStatus("Sending...", "neutral");

        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: input.value.trim(), source: "timeboxxing-landing" }),
          });

          if (!response.ok) {
            throw new Error(`Signup failed with ${response.status}`);
          }

          input.value = "";
          setStatus("You're on the update list. Downloads are still available above.", "success");
        } catch {
          setStatus("Signup failed. You can still download Timeboxxing above.", "error");
        } finally {
          button.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
